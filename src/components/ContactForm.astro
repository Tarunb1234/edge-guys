<form method="POST" action="/api/contact" class="card" style="display:grid;gap:12px;max-width:520px">
  <h3>Request service</h3>
  <p style="color:var(--muted);font-size:14px">Preview only: this form doesn't send anything yet.</p>
  <label>Name <input name="name" required style="width:100%;padding:12px;border:1px solid var(--line);border-radius:8px" /></label>
  <label>Phone <input name="phone" type="tel" required style="width:100%;padding:12px;border:1px solid var(--line);border-radius:8px" /></label>
  <label>What's going on? <textarea name="message" rows="4" style="width:100%;padding:12px;border:1px solid var(--line);border-radius:8px"></textarea></label>
  <button class="btn btn-primary" type="submit" style="border:0;cursor:pointer">Send request</button>
</form>
