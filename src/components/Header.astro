---
import biz from "../data/business.json";
---
<header class="wrap" style="display:flex;justify-content:space-between;align-items:center;padding-top:20px;padding-bottom:20px;gap:16px;flex-wrap:wrap">
  <a href="/" style="font-weight:800;font-size:22px;text-decoration:none">{biz.shortName}</a>
  <nav style="display:flex;gap:22px;align-items:center;flex-wrap:wrap;color:var(--muted)">
    {biz.services.map((s) => <a class="navlink" href={`/services/${s.slug}/`} style="text-decoration:none">{s.title}</a>)}
    <a class="navlink" href="/contact/" style="text-decoration:none">Contact</a>
    <a class="btn btn-primary" href={biz.phoneHref}>Call {biz.phone}</a>
  </nav>
</header>
